@OBSThemeMeta {
    name: 'vadocast';
    id: 'com.vadocast.Dark';
    extends: 'com.obsproject.Yami';
    author: 'vadocast';
    dark: 'true';
}

/* vadocast default theme: red accents on black, white text. */
@OBSThemeVars {
    --vado_red: #E50914;
    --vado_red_light: #F0303A;
    --vado_red_lighter: #FF5A62;
    --vado_red_dark: #B20710;
    --vado_red_darker: #7A050B;

    /* Neutral (untinted) blacks instead of OBS' blue-greys */
    --grey1: #5A5A5A;
    --grey2: #4A4A4A;
    --grey3: #3A3A3A;
    --grey4: #2C2C2C;
    --grey5: #222222;
    --grey6: #1A1A1A;
    --grey7: #121212;
    --grey8: #0B0B0B;

    --bg_window: var(--grey7);
    --bg_base: var(--grey6);
    --bg_preview: var(--grey8);

    --primary: var(--vado_red);
    --primary_light: var(--vado_red_light);
    --primary_lighter: var(--vado_red_lighter);
    --primary_dark: var(--vado_red_dark);
    --primary_darker: var(--vado_red_darker);

    --danger: var(--vado_red_dark);

    --text: #FFFFFF;
    --text_light: #FFFFFF;

    --border_color: var(--grey4);

    --input_bg: var(--grey5);
    --input_border_focus: var(--vado_red);

    --list_item_bg_selected: var(--vado_red_dark);
    --list_item_bg_hover: var(--grey3);

    --button_bg: var(--grey5);
    --button_bg_hover: var(--grey3);
    --button_bg_down: var(--vado_red_darker);
    --button_border: var(--grey4);
    --button_border_hover: var(--vado_red);
    --button_border_focus: var(--vado_red);

    --button_bg_red: var(--vado_red_dark);
    --button_bg_red_hover: var(--vado_red);
    --button_bg_red_down: var(--vado_red_darker);

    --tab_bg_down: var(--vado_red);
    --tab_border_selected: var(--vado_red);

    --scrollbar_hover: var(--vado_red_dark);
    --scrollbar_down: var(--vado_red_darker);

    --highlight_color: var(--vado_red_lighter);

    --palette_highlight: var(--vado_red);
    --palette_link: var(--vado_red_lighter);
    --palette_linkVisited: var(--vado_red_lighter);
}

/* Main controls: "Start Streaming" and "Start Recording" stand out in red once active */
#streamButton:checked,
#recordButton:checked {
    background-color: var(--vado_red);
    border-color: var(--vado_red_lighter);
    color: #FFFFFF;
}

#streamButton:checked:hover,
#recordButton:checked:hover {
    background-color: var(--vado_red_light);
}

QMenuBar::item:selected,
QMenu::item:selected {
    background-color: var(--vado_red_dark);
}

QDockWidget::title {
    border-bottom: 2px solid var(--vado_red_dark);
}

/* ---------------------------------------------------------------------------
 * vadocast identity components (see shared/vadocast/DESIGN.md).
 * Apply with setClasses(widget, "vc-...") from qt-wrappers.hpp.
 * ------------------------------------------------------------------------- */

QMainWindow,
QDialog {
    background-color: #0B0B0B;
}

/* Surfaces */
.vc-panel {
    background-color: #121212;
    border: none;
}

.vc-card {
    background-color: #1A1A1A;
    border: 1px solid #222222;
    border-radius: 10px;
    padding: 8px 12px;
}

.vc-card:hover {
    border-color: #3A3A3A;
}

.vc-card-selected {
    background-color: #2A0A0C;
    border: 1px solid #E50914;
    border-radius: 10px;
}

.vc-preview {
    background-color: #000000;
    border: 1px solid #222222;
    border-radius: 10px;
}

/* Text */
.vc-title {
    font-size: 15pt;
    font-weight: bold;
    color: #FFFFFF;
}

.vc-section-title {
    font-size: 9pt;
    font-weight: bold;
    color: #969696;
    padding: 10px 2px 4px 2px;
}

.vc-label {
    color: #FFFFFF;
}

.vc-caption {
    font-size: 8pt;
    color: #969696;
}

.vc-value {
    color: #FFFFFF;
    font-weight: bold;
    min-width: 40px;
}

/* Buttons */
.vc-primary {
    background-color: #E50914;
    border: 1px solid #E50914;
    border-radius: 8px;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px 18px;
}

.vc-primary:hover {
    background-color: #F0303A;
    border-color: #F0303A;
}

.vc-primary:pressed {
    background-color: #B20710;
}

.vc-primary:disabled {
    background-color: #2C2C2C;
    border-color: #2C2C2C;
    color: #5A5A5A;
}

.vc-secondary {
    background-color: #222222;
    border: 1px solid #2C2C2C;
    border-radius: 8px;
    color: #FFFFFF;
    padding: 7px 14px;
}

.vc-secondary:hover {
    background-color: #2C2C2C;
    border-color: #4A4A4A;
}

.vc-live {
    background-color: #0B0B0B;
    border: 2px solid #E50914;
    border-radius: 8px;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px 18px;
}

.vc-icon-button {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px;
}

.vc-icon-button:hover {
    background-color: #2C2C2C;
}

/* Navigation list (settings sections, add-source types) */
.vc-nav {
    background-color: #121212;
    border: none;
    outline: none;
}

.vc-nav::item {
    color: #D2D2D2;
    border-radius: 6px;
    padding: 8px 10px;
    margin: 1px 4px;
}

.vc-nav::item:hover {
    background-color: #1A1A1A;
}

.vc-nav::item:selected {
    background-color: #222222;
    color: #FFFFFF;
    border-left: 3px solid #E50914;
}

/* Inputs */
.vc-input {
    background-color: #1A1A1A;
    border: 1px solid #2C2C2C;
    border-radius: 8px;
    color: #FFFFFF;
    padding: 6px 10px;
}

.vc-input:focus {
    border-color: #E50914;
}

/* Sliders */
.vc-slider::groove:horizontal {
    height: 4px;
    background: #2C2C2C;
    border-radius: 2px;
}

.vc-slider::sub-page:horizontal {
    background: #E50914;
    border-radius: 2px;
}

.vc-slider::handle:horizontal {
    background: #FFFFFF;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

/* Tabs (Horizontal / Vertical) */
.vc-tabs::tab {
    background: transparent;
    color: #969696;
    padding: 6px 4px;
    margin-right: 16px;
    border: none;
    border-bottom: 2px solid transparent;
}

.vc-tabs::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #E50914;
}

/* ---------------------------------------------------------------------------
 * vadocast main window identity
 * ------------------------------------------------------------------------- */

QMainWindow::separator {
    background: #0B0B0B;
    width: 6px;
    height: 6px;
}

QDockWidget {
    color: #FFFFFF;
    font-weight: bold;
}

QDockWidget::title {
    background-color: #121212;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #1A1A1A;
    text-align: left;
}

QDockWidget > QWidget {
    background-color: #121212;
}

/* Scene and source lists as rounded rows */
SceneTree,
SourceTree,
SceneTree::item,
QListWidget#scenes {
    background-color: #121212;
    border: none;
}

SceneTree::item,
SourceTree::item {
    background-color: #1A1A1A;
    border: 1px solid #222222;
    border-radius: 8px;
    margin: 2px 6px;
    padding: 6px 10px;
    color: #FFFFFF;
}

SceneTree::item:hover,
SourceTree::item:hover {
    border-color: #3A3A3A;
}

SceneTree::item:selected,
SourceTree::item:selected {
    background-color: #2A0A0C;
    border: 1px solid #E50914;
}

/* Small toolbars under the lists */
#scenesToolbar,
#sourcesToolbar {
    background-color: #121212;
    border: none;
    padding: 4px 6px;
}

#scenesToolbar QToolButton,
#sourcesToolbar QToolButton {
    border-radius: 6px;
    padding: 4px;
}

#scenesToolbar QToolButton:hover,
#sourcesToolbar QToolButton:hover {
    background-color: #2C2C2C;
}

/* Preview area */
#preview,
#previewContainer {
    background-color: #000000;
}

/* Menu bar and status bar */
QMenuBar {
    background-color: #0B0B0B;
    color: #D2D2D2;
    border-bottom: 1px solid #1A1A1A;
}

QMenu {
    background-color: #1A1A1A;
    border: 1px solid #2C2C2C;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    border-radius: 6px;
    padding: 6px 14px;
}

QStatusBar {
    background-color: #0B0B0B;
    color: #969696;
    border-top: 1px solid #1A1A1A;
}
